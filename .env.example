# Copy to .env (gitignored). The gateway reads ./.env and ./gateway/.env.

# --- Database (docker compose up -d postgres). Omit to run with the in-memory event store.
DATABASE_URL=postgresql://gateway:gateway@localhost:5433/gateway

# --- Providers. A provider is only used when its variables are set.
# Hosted open models (free tiers; check current limits):
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Local models via Ollama (ollama serve):
# OLLAMA_ENABLED=1
# Hide the mock models once you have real ones:
# GATEWAY_DISABLE_MOCK=1

# --- Gateway auth.
# auto (default): required on Vercel, or when keys / a JWT secret are configured. required | off to force.
# GATEWAY_AUTH=required
# Create keys with:  cd gateway && uv run python scripts/keys.py create --name my-app
# Optional static keys from the environment ("key:name" pairs, comma separated):
# GATEWAY_API_KEYS=dev-key:local
# Optional short-lived tokens signed by your own backend (HS256, use 32+ random bytes):
# GATEWAY_JWT_SECRET=
# GATEWAY_DEFAULT_RATE_LIMIT_PER_MIN=0

# --- Optional second provider keys, used when the first is rejected (rotation / failover)
# GROQ_API_KEY_2=
# OPENROUTER_API_KEY_2=

# --- Error reporting (Sentry, or any Sentry-compatible server such as GlitchTip)
# SENTRY_DSN=

# --- Hosting on Vercel + Neon (set these in the Vercel project, not in a file)
# DATABASE_URL: the *pooled* Neon connection string (host contains "-pooler"), with ?sslmode=require
# SENTRY_DSN:   from your Sentry project (Settings > Client Keys)
# On Vercel auth is required automatically and events are written before each response returns.
# GATEWAY_EMIT_INLINE=auto   # auto (on Vercel) | on | off

# --- Tuning
# GATEWAY_POLICY_TTL_S=30
# GATEWAY_MOCK_LATENCY_SCALE=0.05
