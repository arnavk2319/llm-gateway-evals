# The dashboard has no database access: it reads and writes everything through the gateway's
# internal API (docs-internal/adr/0001). Both values must match the gateway's GATEWAY_DASHBOARD_TOKEN.
GATEWAY_URL=http://localhost:8000
GATEWAY_DASHBOARD_TOKEN=local-dev-dashboard-token-change-me-0123456789

# Local development needs nothing else: sign-up is open and the session secret has a dev default.
# Run the gateway with the same token (see ../.env.example), sign up at http://localhost:3100/signup,
# then create an API key under "API keys".
# For that key to be enforced locally, run the gateway with GATEWAY_AUTH=required.

# --- Production (set these in the Vercel project, never in a file) ---------------------------------
# GATEWAY_URL=                # the gateway's public address, e.g. https://llm-gateway.onrender.com
# GATEWAY_DASHBOARD_TOKEN=    # 32+ random characters (`openssl rand -hex 32`), the same value as on the gateway
# DASHBOARD_SESSION_SECRET=   # required, 32+ random characters, e.g. `openssl rand -hex 32`
# SIGNUP_INVITE_CODE=         # 12+ characters; sign-up needs it. Without it, sign-up is closed
# SIGNUP_MODE=                # invite (default when a code is set) | open | closed
# (Who may be an admin is the gateway's allowlist now: GATEWAY_ADMIN_HASH_KEY / GATEWAY_ADMIN_EMAIL_HASHES. Sign up with the invite code and an allowlisted address.)
# GATEWAY_PUBLIC_URL=         # shown in the key page's code samples, e.g. https://llm-gateway.onrender.com
# APP_URL=                    # public address of this dashboard; links in emails point here (never taken from the request)
# RESEND_API_KEY=             # email provider (resend.com). Without it, local dev prints emails to the console
# EMAIL_FROM=                 # e.g. LLM Gateway <noreply@yourdomain.com>, on a domain verified in Resend
# REQUIRE_EMAIL_VERIFICATION= # set to false only while no email provider exists; users then start verified
#
# Key limits (per-user cap, default and maximum requests/minute) are gateway settings now:
# GATEWAY_KEY_MAX_PER_USER, GATEWAY_KEY_DEFAULT_RPM, GATEWAY_KEY_MAX_RPM.
