# Same database the gateway writes to (docker compose: port 5433).
DATABASE_URL=postgresql://gateway:gateway@localhost:5433/gateway

# --- Login (required in production; the dashboard returns 503 until both are set)
# DASHBOARD_PASSWORD=          # 12+ characters
# DASHBOARD_SESSION_SECRET=    # 32+ random characters, e.g. `openssl rand -hex 32`
# Optional read-only role (gateway/scripts/dashboard_role.sql); falls back to DATABASE_URL.
# DATABASE_URL_READONLY=
